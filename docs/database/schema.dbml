// TABLE 23: leave_transactions  (APPEND-ONLY double-entry ledger)
// ─────────────────────────────────────────────────────────────
Table leave_transactions [note: 'Append-only double-entry leave ledger. LVE-01, ADR-08. NEVER UPDATE/DELETE. RLS: tenant_id.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
