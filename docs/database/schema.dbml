    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 24: pay_runs
// ─────────────────────────────────────────────────────────────
Table pay_runs [note: 'Pay run header / finite-state machine. PAY-01, PAY-04, PAY-06. RLS: tenant_id.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    pay_group_id        UUID        [not null, ref: > pay_groups.id]
    period_start        DATE         [not null]
    period_end          DATE         [not null]
    status              pay_run_status_enum [not null, default: 'DRAFT']
    initiated_by_user_id UUID        [not null, ref: > users.id]
    locked_at           TIMESTAMPTZ  [note: 'Set when status transitions to LOCKED']
    total_gross         NUMERIC(15,2) [note: 'Computed after Step 5']
    total_net           NUMERIC(15,2) [note: 'Computed after Step 6']
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]
    updated_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, pay_group_id, period_start, period_end) [unique, name: 'uq_pay_run_period']
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 25: pay_run_employee_snapshots  (IMMUTABLE after lock)
// ─────────────────────────────────────────────────────────────
Table pay_run_employee_snapshots [note: 'Immutable per-employee payroll snapshot. PAY-06, PSL-03. No retroactive mutation permitted. RLS: tenant_id.'] {
    id                      UUID        [pk, default: `gen_random_uuid()`]
    tenant_id               UUID        [not null, ref: > tenants.id, note: 'RLS column']
    pay_run_id              UUID        [not null, ref: > pay_runs.id]
    employee_id             UUID        [not null, ref: > employees.id]
    gross_earnings          NUMERIC(12,2) [not null]
    total_deductions        NUMERIC(12,2) [not null]
    net_payable             NUMERIC(12,2) [not null]
    lop_days                NUMERIC(4,2)  [not null]
    paid_days               NUMERIC(4,2)  [not null]
    earnings_breakdown      JSONB         [not null, note: 'Base, HRA, Allowances, Incentives per PAY-02']
    deductions_breakdown    JSONB         [not null, note: 'EPF, ESI, PT, TDS, Advances, Loans']
    statutory_inputs        JSONB         [not null, note: 'Version snapshot of EPF/ESI/PT slabs at run time (ADR-25)']
    employee_master_snapshot JSONB        [not null, note: 'Designation, bank account, PAN, EPF UAN at run time']
    payslip_pdf_url         TEXT          [note: 'PSL-01: Signed PDF URL after Step 10']
    created_at              TIMESTAMPTZ   [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, pay_run_id, employee_id) [unique, name: 'uq_payrun_emp']
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 26: statutory_parameter_versions
// ─────────────────────────────────────────────────────────────
Table statutory_parameter_versions [note: 'Versioned EPF/ESI/PT/TDS parameters. ADR-25, STA-01..STA-05. Never hardcoded in source. RLS: tenant_id NULL (platform-level table).'] {
    id              UUID        [pk, default: `gen_random_uuid()`]
    parameter_type  VARCHAR(20)  [not null, note: 'EPF | ESI | PT | TDS | LWF']
    state_code      VARCHAR(5)   [note: 'ISO 3166-2 for PT/LWF; NULL for EPF/ESI (national)']
    effective_from  DATE         [not null]
    effective_to    DATE         [note: 'NULL = currently active version']
    parameters      JSONB        [not null, note: 'Full parameter set: ceilings, slabs, rates, opt-in flags']
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (parameter_type, state_code, effective_from) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 27: audit_logs  (APPEND-ONLY)
// ─────────────────────────────────────────────────────────────
Table audit_logs [note: 'Immutable cryptographic audit trail. PLT-04, PRV-01, SEC-02. PARTITION BY RANGE (created_at) yearly. Append-only WORM enforced. RLS: tenant_id. NFR-02: 8-year retention.'] {
    id              UUID        [not null, default: `gen_random_uuid()`]
    tenant_id       UUID        [ref: > tenants.id, note: 'RLS column; NULL for SUPER_ADMIN platform actions']
    sequence_number BIGSERIAL   [not null]
    prev_entry_hash VARCHAR(64) [not null, note: 'SHA-256 hash of previous log entry for tamper evidence']
    entry_hash      VARCHAR(64) [not null, note: 'SHA-256(prev_entry_hash || tenant_id || payload)']
    user_id         UUID        [ref: > users.id]
    action          VARCHAR(100) [not null, note: 'e.g. PAYSLIP_UNMASKED, PAY_RUN_LOCKED, PUNCH_MANUAL_OVERRIDE']
    entity_type     VARCHAR(100) [not null, note: 'Table/resource affected']
    entity_id       UUID
    ip_address      INET
    before_value    JSONB        [note: 'State snapshot before mutation']
    after_value     JSONB        [note: 'State snapshot after mutation']
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`, note: 'Partition key (yearly range partition)']

    indexes {
        (created_at, tenant_id, id) [pk]
        (tenant_id, entity_type, entity_id, created_at) [name: 'idx_audit_logs_entity']
        (tenant_id, user_id, created_at)                [name: 'idx_audit_logs_user']
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 28: salary_structures  // inferred
// ─────────────────────────────────────────────────────────────
Table salary_structures [note: 'Configurable earnings/deductions formula templates. PAY-02. // inferred. RLS: tenant_id.'] {
    id              UUID        [pk, default: `gen_random_uuid()`]
    tenant_id       UUID        [not null, ref: > tenants.id, note: 'RLS column']
    name            VARCHAR(200) [not null]
