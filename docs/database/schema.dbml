// TABLE 29: employee_salary_assignments  // inferred
// ─────────────────────────────────────────────────────────────
Table employee_salary_assignments [note: 'Effective-dated CTC and salary structure per employee. EMP-02, PAY-02, LFC-05. // inferred. RLS: tenant_id.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    employee_id         UUID        [not null, ref: > employees.id]
    salary_structure_id UUID        [not null, ref: > salary_structures.id]
    ctc_encrypted       TEXT         [not null, note: 'AES-256 encrypted annual CTC figure (EMP-02, SEC-02)']
    effective_from      DATE         [not null]
    effective_to        DATE         [note: 'NULL = current assignment']
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, employee_id, effective_from) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 30: overtime_requests  // inferred
// ─────────────────────────────────────────────────────────────
Table overtime_requests [note: 'OT pre/post-approval workflow. OTC-01, N20. // inferred. RLS: tenant_id.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    employee_id         UUID        [not null, ref: > employees.id]
    attendance_date     DATE         [not null]
    requested_minutes   INT          [not null, note: 'OT minutes requiring authorization']
    approved_minutes    INT          [note: 'Actual approved OT minutes; NULL until approval']
    status              approval_status_enum [not null, default: 'PENDING']
    reviewer_user_id    UUID         [ref: > users.id]
    reviewer_note       TEXT
    is_comp_off         BOOLEAN      [not null, default: false, note: 'OTC-03: Credit as COMP_OFF instead of cash']
    reviewed_at         TIMESTAMPTZ
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, employee_id, attendance_date) [name: 'idx_ot_req_emp_date']
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 31: attendance_monthly_summaries (TIER 3 PRECOMPUTED READ-MODEL)
// ─────────────────────────────────────────────────────────────
Table attendance_monthly_summaries [note: 'Tier 3 precomputed monthly attendance aggregations for rapid muster roll rendering and payroll inputs. RLS: tenant_id.'] {
    id                      UUID            [not null, default: `gen_random_uuid()`]
    tenant_id               UUID            [not null, ref: > tenants.id, note: 'RLS column']
    employee_id             UUID            [not null, ref: > employees.id]
    year_month              VARCHAR(7)      [not null, note: 'YYYY-MM partition period']
    total_scheduled_days    INT             [not null, default: 0]
    present_days            NUMERIC(4,1)    [not null, default: 0.0]
    half_days               INT             [not null, default: 0]
    absent_days             NUMERIC(4,1)    [not null, default: 0.0]
    weekly_off_days         INT             [not null, default: 0]
    holiday_days            INT             [not null, default: 0]
    paid_leave_days         NUMERIC(4,1)    [not null, default: 0.0]
    unpaid_leave_days       NUMERIC(4,1)    [not null, default: 0.0]
    loss_of_pay_days        NUMERIC(4,1)    [not null, default: 0.0]
    total_worked_minutes    INT             [not null, default: 0]
    total_overtime_minutes  INT             [not null, default: 0]
    late_arrival_count      INT             [not null, default: 0]
    early_exit_count        INT             [not null, default: 0]
    is_frozen               BOOLEAN         [not null, default: false, note: 'True when monthly payroll locks']
    version                 INT             [not null, default: 1, note: 'Optimistic locking for recalculation updates']
    updated_at              TIMESTAMPTZ     [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, employee_id, year_month) [pk]
        (tenant_id, year_month) [name: 'idx_monthly_summary_period_lookup']
    }
}

// ─────────────────────────────────────────────────────────────
// RELATIONSHIP COMMENTS (Cardinality)
// ─────────────────────────────────────────────────────────────
// tenants            1 --< branches                 (one tenant has many branches)
// tenants            1 --< employees                (one tenant employs many employees)
// tenants            1 --< pay_groups               (one tenant has many pay groups)
// branches           1 --< departments              (one branch has many departments)
// departments        0..1 --< departments           (self-referential sub-departments)
// employees          1 --< punch_events             (one employee has many punches)
// employees          1 --< dated_shift_instances    (one employee has many shift instances)
// dated_shift_instances 1 --< attendance_daily_records (each instance drives daily records)
// attendance_daily_records 1 --1 attendance_explanation_traces (one trace per record)
// employees          1 --< leave_transactions       (append-only ledger; never 1-1 balance)
// pay_groups         1 --< pay_runs                 (one pay group executes many pay runs)
// pay_runs           1 --< pay_run_employee_snapshots (one run freezes many employee snapshots)
// raw_envelope       1 --< punch_events             (one raw payload normalizes to N events)
