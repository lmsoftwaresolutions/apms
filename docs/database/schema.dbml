    attendance_record_id UUID       [not null, ref: > attendance_daily_records.id, note: 'CASCADE DELETE']
    trace_payload       JSONB        [not null, note: 'Full calculation trace: sessions, gap_intervals, anomalies, rollup. See SPEC §7.']
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]
}

