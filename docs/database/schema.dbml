// ============================================================
// APMS — Complete Database Schema (DBML / dbdiagram.io format)
// Status: Authoritative | Last Updated: 2026-11-16
// Source: Consolidated from DATABASE_DESIGN.md, module SPECs,
//         SECURITY_ARCHITECTURE.md, REQUIREMENTS_CATALOG.md
// ============================================================
// Multi-Tenancy: Every tenant-scoped table carries a non-nullable
// tenant_id UUID column. RLS policy pattern:
//   ALTER TABLE <table> ENABLE ROW LEVEL SECURITY;
//   ALTER TABLE <table> FORCE ROW LEVEL SECURITY;
//   CREATE POLICY tenant_isolation_policy ON <table>
//       FOR ALL USING (tenant_id = current_setting('app.current_tenant_id', true)::uuid)
//       WITH CHECK (tenant_id = current_setting('app.current_tenant_id', true)::uuid);
// ============================================================

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

Enum shift_type_enum {
    FIXED_STANDARD      // SHF-01: Configurable start/end with grace
    OVERNIGHT           // SHF-02: Crosses midnight, start-date attribution
    MULTI_SESSION       // SHF-03: 2+ sessions, mid-gap excluded (N65)
    FLEXIBLE_WINDOW     // SHF-04: Core hours + flexible total duration
    CONTINUOUS_MULTI_DAY // SHF-05: 24h/36h/48h hospital/plant duty
    DYNAMIC_POOL        // SHF-06: Auto-match from shift pool
}

Enum attendance_status_enum {
    PRESENT
    HALF_DAY
    ABSENT
    ON_LEAVE
    WEEKLY_OFF
    HOLIDAY
    NEEDS_REVIEW
    POST_DUTY_REST      // After multi-day continuous duty (Q5)
    CANCELLED_PAID      // Employer-cancelled sessions (N66d)
}

Enum punch_source_enum {
    BIOMETRIC_DEVICE    // Hardware terminal (ZKTeco, eSSL, eTimeOffice)
    RFID_CARD           // Card / proximity alternate (non-biometric)
    MOBILE_APP          // GPS-stamped mobile punch
    KIOSK               // Shared tablet / PIN kiosk (DEV-03)
    CCTV_FRAME          // Edge CCTV walk-through event (no cloud template)
    CSV_IMPORT          // Bulk historical upload (PCH-05)
    MANUAL_ADMIN        // HR override with audit (ATT-12)
    EDGE_AGENT          // On-premises edge sync relay (PCH-04)
}

Enum punch_flag_enum {
    NORMAL
    DUPLICATE_IGNORED   // Within debounce window (PCH-03)
    CLOCK_DRIFT_WARNING // Device drift > 5 min (DEV-04)
    LONE_PUNCH_ANOMALY  // Missing IN or OUT (ATT-06, Q4)
    UNRESOLVED_SHIFT    // No matching shift window
}

Enum leave_transaction_type_enum {
    ACCRUAL             // Periodic credit (LVE-03)
    APPLICATION         // Debit from approved leave
    CANCELLATION        // Credit reversal on cancel
    ENCASHMENT          // Cash-out during payroll (LVE-05)
    LAPSE               // Year-end non-carry expiry (LVE-05)
    MANUAL_ADJUSTMENT   // HR manual correction with audit
}

Enum pay_run_status_enum {
    DRAFT
    ATTENDANCE_RECONCILED
    LEAVE_FROZEN
    VARIABLE_LOADED
    OVERTIME_AUTHORIZED
    GROSS_COMPUTED
    STATUTORY_COMPUTED
    AUDIT_PASSED
    LOCKED              // Immutable after Step 8 (PAY-06)
    DISBURSED
}

Enum approval_status_enum {
    PENDING
    AUTO_APPROVED       // WFH within quota (Q6)
    APPROVED
    REJECTED
    CANCELLED
    DELEGATED           // WFL-03 out-of-office delegation
}

// Note: user_role_enum is DEPRECATED and superseded by dynamic Table roles, Table permissions,
// Table role_permissions, and Table user_roles (ADR-31 & IAM-01). Preserved for legacy reference.
Enum user_role_enum {
    SUPER_ADMIN         // Platform-wide; cross-tenant
    TENANT_ADMIN        // Full tenant config (seeded default bundle)
    HR_PAYROLL          // Payroll wizard, leave admin (seeded default bundle)
    SUPERVISOR          // Roster, approvals (seeded default bundle)
    EMPLOYEE            // Self-service only (seeded default bundle)
}

Enum device_status_enum {
    ACTIVE
    INACTIVE
    MAINTENANCE
    CLOCK_DRIFT_ALERT   // DEV-04
}

Enum webhook_event_enum {
    PAY_RUN_LOCKED
    ATTENDANCE_FINALIZED
    EMPLOYEE_ONBOARDED
    LEAVE_APPROVED
}

// ─────────────────────────────────────────────────────────────
// TABLE 1: tenants  (platform root; NOT tenant-scoped)
// ─────────────────────────────────────────────────────────────
Table tenants [note: 'Platform root. No RLS — accessed only by SUPER_ADMIN. PLT-01, PLT-02.'] {
    id              UUID        [pk, default: `gen_random_uuid()`, note: 'Primary tenant identifier']
    name            VARCHAR(200) [not null, note: 'Legal entity name']
    subdomain       VARCHAR(100) [not null, unique, note: 'URL subdomain for tenant isolation. PLT-02']
    plan_tier       VARCHAR(50)  [not null, default: 'STANDARD', note: 'Subscription plan: STARTER / STANDARD / ENTERPRISE']
    is_active       BOOLEAN      [not null, default: true]
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]
    settings        JSONB        [not null, default: '{}', note: 'Feature flags & defaults. PLT-06']
}

// ─────────────────────────────────────────────────────────────
// TABLE 2: branches
// ─────────────────────────────────────────────────────────────
Table branches [note: 'Physical branches / legal entities within a tenant. ORG-01. RLS: tenant_id.'] {
    id              UUID        [pk, default: `gen_random_uuid()`]
    tenant_id       UUID        [not null, ref: > tenants.id, note: 'RLS column']
    name            VARCHAR(200) [not null]
    code            VARCHAR(20)  [not null, note: 'Short branch code']
    address         TEXT
    state_code      VARCHAR(5)   [note: 'ISO 3166-2 state code for PT slab lookup (STA-03)']
    is_active       BOOLEAN      [not null, default: true]
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, code) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 3: departments  // inferred
// ─────────────────────────────────────────────────────────────
Table departments [note: 'Departments / sub-departments under a branch. ORG-01. RLS: tenant_id. // inferred'] {
    id              UUID        [pk, default: `gen_random_uuid()`]
    tenant_id       UUID        [not null, ref: > tenants.id, note: 'RLS column']
    branch_id       UUID        [not null, ref: > branches.id]
    name            VARCHAR(200) [not null]
    code            VARCHAR(20)  [not null]
    parent_dept_id  UUID        [ref: > departments.id, note: 'Self-referential for sub-departments // inferred']
    is_active       BOOLEAN      [not null, default: true]
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, branch_id, code) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 4: users  (authentication & identity)
// ─────────────────────────────────────────────────────────────
Table users [note: 'Authentication identities. IAM-01, IAM-02, ADR-31. RLS: tenant_id.'] {
    id              UUID         [pk, default: `gen_random_uuid()`]
    tenant_id       UUID         [not null, ref: > tenants.id, note: 'RLS column']
    email           VARCHAR(255) [not null, unique]
    full_name       VARCHAR(200) [not null]
    hashed_password VARCHAR(255) [not null]
    totp_secret     VARCHAR(255) [note: 'AES-256 encrypted TOTP seed. SEC-04']
    is_active       BOOLEAN      [not null, default: true]
    last_login_at   TIMESTAMPTZ
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, id) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 4b: permissions  (global platform catalog / vocabulary)
// ─────────────────────────────────────────────────────────────
Table permissions [note: 'Global catalog of granular permission keys: {module}.{resource}.{action}. IAM-02, ADR-31. Platform read-only.'] {
    id          UUID         [pk, default: `gen_random_uuid()`]
    code        VARCHAR(80)  [not null, unique, note: 'e.g. org.branch.create, employee.employee.read']
    module      VARCHAR(40)  [not null, note: 'iam, org, employee, shift, roster, capture, attendance, leave, muster']
    resource    VARCHAR(40)  [not null, note: 'branch, department, role, employee, punch, etc.']
    action      VARCHAR(20)  [not null, note: 'create | read | update | delete']
    description VARCHAR(200) [not null]
}

// ─────────────────────────────────────────────────────────────
// TABLE 4c: roles  (dynamic per-tenant role definitions)
// ─────────────────────────────────────────────────────────────
Table roles [note: 'Dynamic roles defined per tenant by Tenant Admins or pre-seeded system roles. IAM-01, ADR-31. RLS: tenant_id.'] {
    id          UUID         [pk, default: `gen_random_uuid()`]
    tenant_id   UUID         [not null, ref: > tenants.id, note: 'RLS column']
    code        VARCHAR(40)  [not null, note: 'e.g. TENANT_ADMIN, SUPERVISOR, or custom code like FORECOURT_DSM']
    name        VARCHAR(120) [not null, note: 'Display name, e.g. General Manager, Shift Manager']
    is_system   BOOLEAN      [not null, default: false, note: 'true for protected system roles (cannot be deleted); false for dynamic custom roles']
    created_at  TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, id) [unique]
        (tenant_id, code) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 4d: role_permissions  (permission bundle mapping)
// ─────────────────────────────────────────────────────────────
Table role_permissions [note: 'Maps permission keys to dynamic tenant roles. IAM-01, IAM-02. RLS: tenant_id.'] {
    id            UUID [pk, default: `gen_random_uuid()`]
    tenant_id     UUID [not null, ref: > tenants.id, note: 'RLS column']
    role_id       UUID [not null, ref: > roles.id]
    permission_id UUID [not null, ref: > permissions.id]

    indexes {
        (tenant_id, role_id, permission_id) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 4e: user_roles  (multi-role assignment to users)
// ─────────────────────────────────────────────────────────────
Table user_roles [note: 'Assigns users to roles within a tenant. Effective permissions are union of all roles. IAM-03. RLS: tenant_id.'] {
    id        UUID [pk, default: `gen_random_uuid()`]
    tenant_id UUID [not null, ref: > tenants.id, note: 'RLS column']
    user_id   UUID [not null, ref: > users.id]
    role_id   UUID [not null, ref: > roles.id]

    indexes {
        (tenant_id, user_id, role_id) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 5: employees
// ─────────────────────────────────────────────────────────────
Table employees [note: 'Core employee master. EMP-01, EMP-02, SEC-02. PII fields AES-256 encrypted. RLS: tenant_id.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    user_id             UUID        [ref: > users.id, note: 'Auth identity link']
    branch_id           UUID        [not null, ref: > branches.id]
    department_id       UUID        [ref: > departments.id]
    employee_code       VARCHAR(50)  [not null, note: 'HR-assigned unique code per tenant']
    full_name           VARCHAR(300) [not null]
    designation         VARCHAR(200)
    date_of_joining     DATE         [not null]
    date_of_birth       DATE
    employment_type     VARCHAR(50)  [not null, note: 'FULL_TIME / PART_TIME / CONTRACT / TRAINEE']
    probation_end_date  DATE         [note: 'LFC-02: Extended by LOP days']
    confirmation_date   DATE         [note: 'LFC-03: Triggers leave accrual update']
    // ─── PII Encrypted Fields (SEC-02, EMP-02) ───
    pan_encrypted       TEXT         [note: 'AES-256-GCM encrypted PAN. Masked as XXXXX1234 in API']
    aadhaar_encrypted   TEXT         [note: 'AES-256-GCM encrypted Aadhaar (12-digit)']
    bank_account_encrypted TEXT      [note: 'AES-256-GCM encrypted bank account number']
    bank_ifsc_encrypted TEXT         [note: 'AES-256-GCM encrypted IFSC code']
    epf_uan             VARCHAR(50)  [note: 'Universal Account Number for EPF (STA-01)']
    esic_number         VARCHAR(50)  [note: 'ESIC insurance number (STA-02)']
    is_active           BOOLEAN      [not null, default: true]
    biometric_consent_at TIMESTAMPTZ [note: 'DPDP Act 2023 explicit biometric consent timestamp (PRV-01)']
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]
    updated_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, employee_code) [unique]
        (tenant_id, user_id) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 6: pay_groups
// ─────────────────────────────────────────────────────────────
Table pay_groups [note: 'Pay cycle configuration. PAY-04, EMP-03. RLS: tenant_id.'] {
    id              UUID        [pk, default: `gen_random_uuid()`]
    tenant_id       UUID        [not null, ref: > tenants.id, note: 'RLS column']
    name            VARCHAR(200) [not null]
    pay_cycle       VARCHAR(20)  [not null, note: 'CALENDAR_MONTH | CUSTOM_CUTOFF']
    cutoff_day      SMALLINT     [note: 'Day of month for custom cutoff (N18); NULL for calendar month']
    is_active       BOOLEAN      [not null, default: true]
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, name) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 7: employee_pay_group_assignments  // inferred
// ─────────────────────────────────────────────────────────────
Table employee_pay_group_assignments [note: 'Many-to-one: employee→pay_group with effective dating. EMP-03. // inferred. RLS: tenant_id.'] {
    id              UUID        [pk, default: `gen_random_uuid()`]
    tenant_id       UUID        [not null, ref: > tenants.id, note: 'RLS column']
    employee_id     UUID        [not null, ref: > employees.id]
    pay_group_id    UUID        [not null, ref: > pay_groups.id]
    effective_from  DATE         [not null]
    effective_to    DATE         [note: 'NULL = current assignment']
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, employee_id, effective_from) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 8: devices
// ─────────────────────────────────────────────────────────────
Table devices [note: 'Biometric terminal master catalog. DEV-01, DEV-02. RLS: tenant_id.'] {
    id              UUID        [pk, default: `gen_random_uuid()`]
    tenant_id       UUID        [not null, ref: > tenants.id, note: 'RLS column']
    branch_id       UUID        [not null, ref: > branches.id]
    serial_number   VARCHAR(100) [not null]
    brand           VARCHAR(100) [note: 'ZKTeco / eSSL / eTimeOffice / Custom']
    protocol        VARCHAR(50)  [note: 'ADMS_PUSH / HTTP_WEBHOOK / USB_POLL / RS485']
    ip_address      INET
    location_label  VARCHAR(200)
    device_token    VARCHAR(255) [not null, note: 'Secret auth token for push API (PCH-01)']
    status          device_status_enum [not null, default: 'ACTIVE']
    last_heartbeat_at TIMESTAMPTZ [note: 'DEV-02: Updated every 60 s']
    clock_drift_seconds INT       [not null, default: 0, note: 'DEV-04: drift vs NTP']
    firmware_version VARCHAR(50)
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, serial_number) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 9: employee_device_mappings
// ─────────────────────────────────────────────────────────────
Table employee_device_mappings [note: 'Links employee IDs to biometric device user IDs. EMP-04. RLS: tenant_id.'] {
    id              UUID        [pk, default: `gen_random_uuid()`]
    tenant_id       UUID        [not null, ref: > tenants.id, note: 'RLS column']
    employee_id     UUID        [not null, ref: > employees.id]
    device_id       UUID        [not null, ref: > devices.id]
    device_user_id  VARCHAR(50)  [not null, note: 'User ID on the hardware terminal']
    is_active       BOOLEAN      [not null, default: true]
    created_at      TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, device_id, device_user_id) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 10: raw_envelope  (APPEND-ONLY, PARTITIONED)
// ─────────────────────────────────────────────────────────────
Table raw_envelope [note: 'Immutable raw punch ingestion. PCH-01. PARTITION BY RANGE (received_at) monthly. RLS: tenant_id. APPEND-ONLY — no UPDATE/DELETE.'] {
    id              UUID        [not null, default: `gen_random_uuid()`]
    tenant_id       UUID        [not null, note: 'RLS column; also part of composite PK partition key']
    device_id       UUID        [ref: > devices.id, note: 'NULL for CSV imports']
    raw_payload     JSONB        [not null, note: 'Exact device payload stored verbatim']
    payload_hash    VARCHAR(64)  [not null, note: 'SHA-256(tenant_id || device_id || raw_payload). PCH-03 dedup key']
    source          punch_source_enum [not null]
    received_at     TIMESTAMPTZ  [not null, default: `clock_timestamp()`, note: 'Partition key (monthly range partition)']

    // Composite PK includes partition key per PostgreSQL declarative partitioning
    indexes {
        (received_at, tenant_id, id) [pk]
        (tenant_id, payload_hash, received_at) [name: 'uq_raw_envelope_hash', note: 'Idempotent dedup index (PCH-03)']
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 11: punch_events  (PARTITIONED)
// ─────────────────────────────────────────────────────────────
Table punch_events [note: 'Normalized punch stream. PCH-02. PARTITION BY RANGE (punch_time) monthly. RLS: tenant_id.'] {
    id                  UUID        [not null, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, note: 'RLS column; part of composite PK']
    employee_id         UUID        [not null, ref: > employees.id]
    device_id           UUID        [ref: > devices.id]
    raw_envelope_id     UUID        [not null, note: 'Links to raw_envelope.id (non-FK across partitions)']
    punch_time          TIMESTAMPTZ  [not null, note: 'UTC normalized punch timestamp; partition key']
    punch_time_local    TIMESTAMPTZ  [not null, note: 'Tenant-timezone-converted punch timestamp']
    source              punch_source_enum [not null]
    flag                punch_flag_enum   [not null, default: 'NORMAL']
    gps_latitude        NUMERIC(10,7)     [note: 'Mobile GPS coordinate (MOB-01)']
    gps_longitude       NUMERIC(10,7)     [note: 'Mobile GPS coordinate (MOB-01)']
    is_geofence_valid   BOOLEAN           [note: 'NULL for non-mobile sources']
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (punch_time, tenant_id, id) [pk]
        (tenant_id, employee_id, punch_time) [name: 'idx_punch_events_emp_time']
        (tenant_id, employee_id, punch_time) [name: 'idx_punch_events_emp_time_covered', note: 'Covered index with INCLUDE (source, flag, is_geofence_valid)']
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 12: shift_templates
// ─────────────────────────────────────────────────────────────
Table shift_templates [note: 'Reusable shift definition master. SHF-01..SHF-06. RLS: tenant_id.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    code                VARCHAR(30)  [not null]
    name                VARCHAR(200) [not null]
    type                shift_type_enum [not null]
    session_definitions JSONB        [not null, note: 'Array of {session_index, start_time, end_time, min_presence_pct}. N65, N66b.']
    grace_and_breaks    JSONB        [not null, note: '{grace_arrival_min, grace_exit_min, break_definitions[]}. ATT-04.']
    half_day_threshold_minutes INT   [note: 'SHF-01: Minutes threshold for HALF_DAY status']
    full_day_threshold_minutes INT   [note: 'SHF-01: Minutes threshold for FULL PRESENT status']
    is_overnight        BOOLEAN      [not null, default: false, note: 'SHF-02']
    is_active           BOOLEAN      [not null, default: true]
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]
    updated_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, code) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 13: shift_pools  // inferred structure from SPEC
// ─────────────────────────────────────────────────────────────
Table shift_pools [note: 'Dynamic shift matching pools. SHF-06. RLS: tenant_id.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    name                VARCHAR(200) [not null]
    eligible_shift_ids  UUID[]       [not null, note: 'Array of shift_template IDs in pool']
    auto_match_strategy VARCHAR(50)  [not null, default: 'MIN_ARRIVAL_DELTA', note: 'AUTO_DYNAMIC_MATCH algorithm (SHF-06)']
    is_active           BOOLEAN      [not null, default: true]
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, name) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 14: roster_patterns
// ─────────────────────────────────────────────────────────────
Table roster_patterns [note: 'Repeating roster rotation definitions. ROS-01, ROS-02. RLS: tenant_id.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    name                VARCHAR(200) [not null]
    cycle_length_days   SMALLINT     [not null, note: 'e.g. 7 for weekly, 42 for 6-week cycle']
    day_shift_mapping   JSONB        [not null, note: 'Array of {day_index, shift_template_id | null (OFF)}']
    is_active           BOOLEAN      [not null, default: true]
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, name) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 15: dated_shift_instances
// ─────────────────────────────────────────────────────────────
Table dated_shift_instances [note: 'Materialized concrete shift instance per employee per date. ROS-03, N67. RLS: tenant_id. Composite FK source for attendance_daily_records.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    employee_id         UUID        [not null, ref: > employees.id]
    shift_date          DATE         [not null]
    shift_template_id   UUID         [ref: > shift_templates.id, note: 'Source template; NULL for WEEKLY_OFF or REST days']
    roster_pattern_id   UUID         [ref: > roster_patterns.id, note: 'NULL for ad-hoc or dynamic match']
    resolution_mode     VARCHAR(50)  [not null, note: 'ROSTER_PATTERN | AUTO_DYNAMIC_MATCH | ADHOC_OVERRIDE | SHIFT_SWAP | MANUAL']
    sessions            JSONB        [not null, note: 'Snapshot of session windows at materialization time (ADR-15)']
    is_weekly_off       BOOLEAN      [not null, default: false]
    is_adhoc_modified   BOOLEAN      [not null, default: false, note: 'N67 override flag']
    override_reason     TEXT         [note: 'N67: Mandatory reason when is_adhoc_modified=true']
    modified_by_user_id UUID         [ref: > users.id, note: 'N67 supervisor who performed override']
    cancelled_sessions  JSONB        [note: 'N66d: Array of cancelled session indices with CANCELLED_PAID marker']
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, employee_id, shift_date) [unique, name: 'uq_shift_instance_emp_date']
        (tenant_id, id)                      [unique, name: 'uq_dated_shift_instances_id_tenant', note: 'Composite FK target for attendance_daily_records (DATABASE_DESIGN.md §1.2)']
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 16: attendance_daily_records
// ─────────────────────────────────────────────────────────────
Table attendance_daily_records [note: 'Daily attendance rollup per employee. ATT-07 (N66a). RLS: tenant_id. Read-only input to payroll (ADR-07). Composite FK to dated_shift_instances.'] {
    id                  UUID        [pk, default: `gen_random_uuid()`]
    tenant_id           UUID        [not null, ref: > tenants.id, note: 'RLS column']
    employee_id         UUID        [not null, ref: > employees.id]
    attendance_date     DATE         [not null]
    shift_instance_id   UUID         [note: 'Composite FK (tenant_id, shift_instance_id) → dated_shift_instances(tenant_id, id)']
    status              attendance_status_enum [not null]
    worked_minutes      INT          [not null, default: 0]
    scheduled_minutes   INT          [not null, default: 0]
    late_in_minutes     INT          [not null, default: 0]
    early_exit_minutes  INT          [not null, default: 0]
    overtime_minutes    INT          [not null, default: 0, note: 'Only approved OT (N20, OTC-01)']
    is_regularized      BOOLEAN      [not null, default: false, note: 'ATT-10: Self-service regularization']
    is_locked           BOOLEAN      [not null, default: false, note: 'PAY-06: Set true at payroll freeze']
    updated_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, employee_id, attendance_date) [unique, name: 'uq_emp_attendance_date']
    }
}

// ─────────────────────────────────────────────────────────────
