    accrual_days        NUMERIC(4,2) [note: 'Days credited per accrual period']
    max_carry_forward   NUMERIC(4,2) [note: 'LVE-05: Maximum carry-forward days at year-end']
    allow_negative      BOOLEAN      [not null, default: false, note: 'LVE-06']
    sandwich_rule_applies BOOLEAN    [not null, default: false, note: 'LVE-04: BR-LVE-02']
    is_active           BOOLEAN      [not null, default: true]
    created_at          TIMESTAMPTZ  [not null, default: `clock_timestamp()`]

    indexes {
        (tenant_id, code) [unique]
    }
}

// ─────────────────────────────────────────────────────────────
// TABLE 22: leave_requests
